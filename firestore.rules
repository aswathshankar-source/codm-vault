rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isEmailUser() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    match /pendingVerifications/{verificationId} {
      allow create: if isAnonymous()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'email', 'status', 'firebaseUid',
          'createdAt', 'expiresAt', 'verifiedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.status == 'pending'
        && request.resource.data.firebaseUid == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm')
        && request.resource.data.verifiedAt == null;

      allow read: if isAnonymous()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.expiresAt > request.time;

      allow update: if isEmailUser()
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'email', 'status', 'firebaseUid',
          'createdAt', 'expiresAt', 'verifiedAt'
        ])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status == 'verified'
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.verifiedAt == request.time;

      allow delete: if isAnonymous()
        && resource.data.ownerUid == request.auth.uid
        && (resource.data.status == 'pending' || resource.data.status == 'verified');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
